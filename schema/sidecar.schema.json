{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Sidecar",
  "type": "object",
  "required": [
    "capture",
    "group",
    "id",
    "image",
    "name",
    "platform",
    "schema_version"
  ],
  "properties": {
    "capture": {
      "type": "string"
    },
    "captured_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "display_name": {
      "type": [
        "string",
        "null"
      ]
    },
    "env": {
      "anyOf": [
        {
          "$ref": "#/definitions/EnvInfo"
        },
        {
          "type": "null"
        }
      ]
    },
    "ext": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": true
    },
    "group": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "image": {
      "$ref": "#/definitions/ImageInfo"
    },
    "name": {
      "type": "string"
    },
    "platform": {
      "type": "string"
    },
    "schema_version": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "source": {
      "anyOf": [
        {
          "$ref": "#/definitions/SourceInfo"
        },
        {
          "type": "null"
        }
      ]
    },
    "variant": {
      "default": {},
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "definitions": {
    "EnvInfo": {
      "type": "object",
      "properties": {
        "arch": {
          "type": [
            "string",
            "null"
          ]
        },
        "ci": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "device": {
          "type": [
            "string",
            "null"
          ]
        },
        "os": {
          "type": [
            "string",
            "null"
          ]
        },
        "renderer": {
          "type": [
            "string",
            "null"
          ]
        },
        "sdk": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "ImageInfo": {
      "type": "object",
      "required": [
        "height",
        "scale",
        "width"
      ],
      "properties": {
        "height": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        },
        "scale": {
          "type": "number",
          "format": "double"
        },
        "width": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0.0
        }
      }
    },
    "SourceInfo": {
      "type": "object",
      "required": [
        "file"
      ],
      "properties": {
        "file": {
          "type": "string"
        },
        "line": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0.0
        }
      }
    }
  }
}